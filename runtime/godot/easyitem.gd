@tool
class_name EasyItem
extends Resource
## One Easy Items item (generated by `easyitems export --preset godot`).

@export var id: String = ""
@export var name_th: String = ""
@export var name_en: String = ""
@export var name_ms: String = ""
@export_multiline var desc_th: String = ""
@export_multiline var desc_en: String = ""
@export var category: String = ""
@export var price: int = 0
@export var stack: int = 1
@export var icon: Texture2D
@export var effects: Array = []
@export var equip_slot: String = ""
@export var equip_stats: Dictionary = {}
@export var rarity: String = "common"
@export var tags: PackedStringArray = PackedStringArray()


func display_name(lang: String = "th") -> String:
	match lang:
		"en":
			return name_en
		"ms":
			return name_ms if name_ms != "" else name_en
	return name_th
